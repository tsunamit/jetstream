{
  "name": "jetstream-desktop",
  "productName": "Jetstream",
  "version": "0.1.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "scrollbars-smoke": "node scrollbars-smoke.cjs",
    "activity-smoke": "node activity-smoke.cjs",
    "title-rows-smoke": "node title-rows-smoke.cjs",
    "recent-smoke": "node recent-smoke.cjs",
    "traversal-smoke": "node traversal-smoke.cjs",
    "start": "electron .",
    "demo": "electron . --demo",
    "live": "electron . --live",
    "dev": "node dev-launch.cjs",
    "dev-smoke": "node dev-smoke.cjs",
    "dev-test": "node --test dev-watch.test.cjs dev-runtime.test.cjs",
    "test": "node --test working-cube.test.cjs api.test.cjs media.test.cjs keymaps.test.cjs motions.test.cjs workspace.test.cjs transcript.test.cjs navigation.test.cjs connection.test.cjs navigation-ux.test.cjs stream.test.cjs zoom.test.cjs unread.test.cjs central-search.test.cjs layout-state.test.cjs reference-targets.test.cjs activity-state.test.cjs keyboard-routing.test.cjs chat-geometry.test.cjs conversation-settings.test.cjs product-identity.test.cjs",
    "keyboard-routing-smoke": "node keyboard-routing-smoke.cjs",
    "wrapped-chat-smoke": "node wrapped-chat-smoke.cjs",
    "working-smoke": "node working-smoke.cjs",
    "conversation-controls-smoke": "node conversation-controls-smoke.cjs",
    "references-smoke": "node references-smoke.cjs",
    "splits-smoke": "node splits-smoke.cjs",
    "reply-growth-smoke": "node reply-growth-smoke.cjs",
    "reply-layout-smoke": "node reply-layout-smoke.cjs",
    "zoom-smoke": "node zoom-smoke.cjs",
    "stream-smoke": "node stream-smoke.cjs",
    "panes-smoke": "node panes-smoke.cjs",
    "keymaps-smoke": "node keymaps-smoke.cjs",
    "build": "node build.cjs",
    "rich-smoke": "node rich-smoke.cjs",
    "layout-smoke": "node layout-smoke.cjs",
    "prepack": "npm run build",
    "smoke": "node smoke.cjs",
    "history-smoke": "node history-smoke.cjs",
    "picker-smoke": "node picker-smoke.cjs",
    "postinstall": "install-electron",
    "pack": "electron-packager . 'Jetstream' --platform=darwin --arch=arm64 --out=dist --ignore='^/(dist|build|\\.gitignore|dev-.*|(Capy Terminal Dev|Jetstream Dev)\\.command|DEV\\.md|.*-smoke\\.cjs|smoke\\.cjs|.*\\.test\\.cjs|README\\.md|test-support\\.cjs|hidden-proof\\.cjs)$' --app-bundle-id=local.ryan.capy-terminal --overwrite",
    "postpack": "codesign --force --deep --sign - 'dist/Jetstream-darwin-arm64/Jetstream.app'",
    "composer-smoke": "node composer-smoke.cjs",
    "halfpage-smoke": "node halfpage-smoke.cjs",
    "hidden-proof": "node hidden-proof.cjs",
    "windows-smoke": "node windows-smoke.cjs",
    "branding-smoke": "node branding-smoke.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.4.1",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.1"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@replit/codemirror-vim": "6.4.0",
    "dompurify": "3.4.18",
    "ipaddr.js": "2.2.0",
    "marked": "18.2.1",
    "mermaid": "12.3.0"
  }
}
